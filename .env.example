# Copia in .env e compila. Il file .env non va mai committato.
# Lettura delle distinte: YepAPI (se presente) oppure API Anthropic diretta
YEPAPI_API_KEY=
YEPAPI_MODEL=anthropic/claude-haiku-5.5
ANTHROPIC_API_KEY=
APP_USER=
APP_PASSWORD=
SINFONIA_USER=
SINFONIA_PASSWORD=
# 1 = durante la compilazione si vede il browser (utile sul proprio PC)
BROWSER_VISIBILE=1
